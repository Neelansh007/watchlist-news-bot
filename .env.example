# ============================================================
# watchlist-news-bot environment configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env`. NEVER paste secrets into chat.
# ============================================================

# --- Database (PostgreSQL) ---------------------------------
# Replace <USER> and <PASSWORD> with your local PostgreSQL credentials.
# The database name MUST be watchlist_bot (created by `npm run setup:db`).
DATABASE_URL=postgres://<USER>:<PASSWORD>@localhost:5432/watchlist_bot

# --- Mudrex exchange ---------------------------------------
# Your Mudrex API secret (sent as the X-Authentication header).
# Leave empty for paper-only operation without live account reads.
MUDREX_API_SECRET=

# Base URL is verified against docs.trade.mudrex.com. Override only if Mudrex changes it.
MUDREX_BASE_URL=https://trade.mudrex.com/fapi/v1

# --- Anthropic review agent ----------------------------------
# Your Anthropic API key. If empty, the review agent FAILS CLOSED
# (flags every candidate trade for human review; no trade is placed).
ANTHROPIC_API_KEY=

# Reviewer model id. "claude-sonnet-5-5" (default) or "claude-opus-5-5" for a stronger reviewer.
REVIEW_MODEL=claude-sonnet-5-5

# --- Live trading safety gates -------------------------------
# BOTH must be set for live trading to even be considered:
#   LIVE_TRADING_ALLOWED=true
#   LIVE_TRADING_CONFIRMATION=I-UNDERSTAND-ENABLE-LIVE-TRADING
# A third gate exists in code (LIVE_TRADING_MASTER_SWITCH in lib/safety/live-guard.ts)
# and is false in this build. Defaults below = PAPER mode. Do not change casually.
LIVE_TRADING_ALLOWED=false
LIVE_TRADING_CONFIRMATION=

# --- News -----------------------------------------------------
# Comma-separated public RSS feed URLs.
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://www.investing.com/rss/news.rss
# How far back to look for headlines per run (hours).
NEWS_LOOKBACK_HOURS=24
# Optional API-key-based news provider (e.g. newsapi.org). Leave empty to disable.
# The provider expects a NewsAPI-style JSON response and is off until both are set.
NEWS_API_URL=
NEWS_API_KEY=
